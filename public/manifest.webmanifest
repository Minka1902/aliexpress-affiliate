{
  "name": "AffiLink — AliExpress Affiliate",
  "short_name": "AffiLink",
  "description": "Turn any AliExpress link into your affiliate link",
  "start_url": "/dashboard",
  "display": "standalone",
  "background_color": "#f5f5f5",
  "theme_color": "#E62E04",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/dashboard/link-generator",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "shared"
    }
  }
}
