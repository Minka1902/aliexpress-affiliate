// AliExpress Affiliate App — data model
// Privacy invariants: trackingId, aiKeyEncrypted, and DS tokens are SERVER-ONLY and must
// never be serialized to the client (see src/dto/user.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  FAMILY
  PARTNERS_FAMILY
  FRIENDS
  PARTNERS_FRIENDS
  ADMIN
}

enum Status {
  ACTIVE
  BANNED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(USER)
  status       Status   @default(ACTIVE)

  // SERVER-ONLY: the AliExpress tracking (affiliate) ID.
  // USER role = default (shared) tracking id; privileged roles = personal id.
  trackingId   String?

  // Paid feature unlocks (admin & privileged roles are entitled regardless — see lib/roles.ts)
  unlockedAi       Boolean @default(false)
  unlockedCart     Boolean @default(false)
  unlockedWishlist Boolean @default(false)

  // First-login onboarding (theme/language) completed at
  onboardedAt  DateTime?

  // Email verification (non-blocking)
  emailVerifiedAt DateTime?

  // Preferences
  theme        String?  @default("aliexpress")
  locale       String?  @default("en")
  shipToCountry String? @default("US")

  // AI: provider + encrypted (AES-GCM) BYO key. SERVER-ONLY.
  aiProvider     String? // "claude" | "openai" | "gemini"
  aiKeyEncrypted String?

  // Phase 2 (DS payments) — encrypted OAuth tokens. SERVER-ONLY.
  dsAccessTokenEnc  String?
  dsRefreshTokenEnc String?
  dsTokenExpiry     DateTime?

  links     GeneratedLink[]
  addresses Address[]
  tokens    VerificationToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Password-reset and email-verification tokens. Only a SHA-256 hash of the token is stored;
// the raw token is emailed.
model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "RESET" | "VERIFY"
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Single-row app configuration controlled by the admin.
model AppConfig {
  id               Int      @id @default(1)
  priceAi          Int      @default(500)  // minor units (e.g. cents)
  priceCart        Int      @default(300)
  priceWishlist    Int      @default(300)
  priceBundle      Int      @default(900)
  bundleEnabled    Boolean  @default(true)
  currency         String   @default("USD")
  defaultTrackingId String?
  updatedAt        DateTime @updatedAt
}

model GeneratedLink {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceUrl    String
  productId    String?
  affiliateUrl String?
  eligible     Boolean  @default(false)
  title        String?
  imageUrl     String?
  tags         String? // comma-separated
  note         String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

// Phase 2 — checkout/shipping address for ds.order.create
model Address {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  country       String
  province      String?
  city          String
  address       String
  address2      String?
  zip           String
  phone         String
  phoneCountry  String?
  locale        String? @default("en_US")
  taxNumber     String?
  isDefault     Boolean @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
}
