# --- Database ---
# Local dev: a file in the project. Production (Render/Railway): mount a persistent disk
# and use e.g. file:/data/app.db
DATABASE_URL="file:./dev.db"

# --- Auth / sessions ---
# 32+ char random string. Generate: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"
# The single admin account email (gets ADMIN role + access to /admin)
ADMIN_EMAIL="you@example.com"
# Seed password for the admin account (only used by prisma/seed.ts on first seed)
ADMIN_PASSWORD="change-me"

# --- AES-GCM encryption for stored secrets (AI keys, DS tokens) ---
# 32-byte key, base64 encoded. Generate: openssl rand -base64 32
ENCRYPTION_KEY="change-me-32-byte-base64-key"

# --- AliExpress Open Platform (KEEP SECRET, never commit real values) ---
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_GATEWAY="https://api-sg.aliexpress.com/sync"
# Default ship-to country (ISO-2) used for link generation / queries
DEFAULT_SHIP_COUNTRY="US"
DEFAULT_CURRENCY="USD"

# --- Free built-in AI overview (app-provided fallback when a user has no key) ---
# An Anthropic API key the app uses for the rate-limited free overview. Optional.
FREE_AI_KEY=""

# --- Email (approval / admin-notify) ---
# SMTP settings for nodemailer. Leave blank to log emails to console in dev.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="AliExpress Affiliate <no-reply@example.com>"

# --- Phase 2: in-app payments via aliexpress.ds.order.create (disabled by default) ---
ENABLE_DS_PAYMENTS="false"
ALIEXPRESS_OAUTH_REDIRECT="http://localhost:3000/api/oauth/callback"
